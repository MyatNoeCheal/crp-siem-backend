# ============================================================
# Smart SIEM backend -- copy to .env (never commit .env)
# Names below match exactly what the code reads.
# ============================================================

# --- REQUIRED: app refuses to start without these ----------
# Machine-to-machine key (LectroHub sends this as the X-API-Key header)
SIEM_API_KEY=
# Analyst login token signing secret, >= 32 chars.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SIEM_JWT_SECRET=

# --- Database ----------------------------------------------
# Local default is used if unset. Use your Atlas URI in production.
MONGODB_URI=mongodb://localhost:27017

# --- CORS ---------------------------------------------------
# Comma-separated browser origins allowed to call the API.
# Dev default: http://localhost:5173. Production: your deployed frontend URL.
ALLOWED_ORIGINS=http://localhost:5173

# --- Threat intelligence (optional) -------------------------
ABUSEIPDB_API_KEY=

# --- JARVIS SOC assistant LLM (optional) --------------------
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=800
APP_HTTP_REFERER=http://localhost:8000
APP_NAME=LectroHub SOC

# Local alternative: Ollama
# LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_NUM_CTX=2048

# --- Simulator scripts only (not read by the server) --------
# SIEM_API_KEY_LIVE=
# SIEM_API_KEY_LOCAL=
