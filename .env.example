# FastAPI SIEM backend
API_KEY=change-me
JWT_SECRET_KEY=change-me

# Hosted LLM provider for the SOC assistant
# Recommended: OpenRouter (OpenAI-compatible API) for faster CPU-free responses.
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=your_api_key_here
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=800
APP_HTTP_REFERER=http://localhost:8000
APP_NAME=LectroHub SOC

# Legacy fallback: local Ollama if you want to keep testing without a hosted key.
# LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_NUM_CTX=2048

# Optional older compatibility variables
# OPENROUTER_API_KEY=your_api_key_here
# OPENAI_API_KEY=your_api_key_here
